APP_NAME=orbit
APP_ENV=development
ORBIT_HOST=0.0.0.0
ORBIT_PORT=8080
ORBIT_LOG_LEVEL=info
ORBIT_READ_TIMEOUT=15s
ORBIT_WRITE_TIMEOUT=15s
ORBIT_IDLE_TIMEOUT=60s
ORBIT_READ_HEADER_TIMEOUT=5s
ORBIT_SHUTDOWN_TIMEOUT=10s
DATABASE_ENABLED=false
DATABASE_URL=postgresql://username:password@localhost:5432/orbit?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=10m
DATABASE_HEALTH_CHECK_PERIOD=30s